# =============================================================================
# BRAKMASRA — Environment variables (PUBLIC TEMPLATE)
# =============================================================================
# This file is committed to git. It documents every key the app understands and
# must stay free of real values.
#
# Copy it to `.env` and put your real values there. `.env` is gitignored and
# must never be committed.
#
#   cp .env.example .env      # macOS / Linux
#   copy .env.example .env    # Windows (cmd)
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser — keep
# every secret un-prefixed.
# =============================================================================

# -----------------------------------------------------------------------------
# Site  (used now)
# -----------------------------------------------------------------------------
# Canonical production origin, e.g. https://brakmasra.com. Used for metadata,
# sitemap, robots, and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# YouTube  (used now — server-only)
# -----------------------------------------------------------------------------
# Data API v3 key for live channel refresh. Falls back to data/channel.ts when
# absent. Never expose through NEXT_PUBLIC_.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCJS5mX07b98qeG4Lhqa12XQ

# Optional quota guards (safe to leave blank).
# One refresh costs 2 API units against a 10,000 unit/day free allowance.
# YOUTUBE_DAILY_CALL_BUDGET  max upstream calls per UTC day (default 200)
# YOUTUBE_REVALIDATE_SECONDS cache lifetime, min 300 (default 3600)
YOUTUBE_DAILY_CALL_BUDGET=
YOUTUBE_REVALIDATE_SECONDS=

# -----------------------------------------------------------------------------
# Supabase / PostgreSQL  (used now — server-only)
# -----------------------------------------------------------------------------
# Project URL and a server-only secret key from Project Settings > API.
# SUPABASE_SECRET_KEY is preferred; SUPABASE_SERVICE_ROLE_KEY is a legacy
# fallback. Never prefix either with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct/pooled PostgreSQL connection string for migrations and transactions.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Admin / session  (used now — server-only)
# -----------------------------------------------------------------------------
# Long random string for session signing. ADMIN_PASSWORD_HASH must be a hash,
# never a plaintext password.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# Payments — Stripe  (reserved: checkout adapter fails closed until set)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Transactional email  (reserved: contact / newsletter delivery adapter)
# -----------------------------------------------------------------------------
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
MERCH_SUPPORT_EMAIL=
BUSINESS_EMAIL=

# -----------------------------------------------------------------------------
# Social links  (optional — owner-approved public URLs only)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# -----------------------------------------------------------------------------
# Analytics  (optional — privacy-respecting, consent-gated)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=
