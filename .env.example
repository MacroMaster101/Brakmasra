# =============================================================================
# BRAKMASRA — Environment variables (PUBLIC TEMPLATE)
# =============================================================================
# This file is committed to git. It documents every key the app understands and
# must stay free of real values.
#
# Copy it to `.env` and put your real values there. `.env` is gitignored and
# must never be committed.
#
#   cp .env.example .env      # macOS / Linux
#   copy .env.example .env    # Windows (cmd)
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser — keep
# every secret un-prefixed.
# =============================================================================

# -----------------------------------------------------------------------------
# Site  (used now)
# -----------------------------------------------------------------------------
# Canonical production origin, e.g. https://brakmasra.com. Used for metadata,
# sitemap, robots, social cards, and the Google sign-in return address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Launch gate. Keep on while unfinished routes should show the launch-status
# pages. Set to off to restore the complete auth and commerce implementations.
BRAKMASRA_LAUNCH_MODE=on

# Member sign-in gate, separate from the store. on opens login, signup, and
# accounts while the store is still in launch mode; off keeps them closed;
# empty follows BRAKMASRA_LAUNCH_MODE. Sign-in stays closed until the Supabase
# URL and publishable key below are set.
BRAKMASRA_AUTH_MODE=

# Local preview only. With launch mode off, set this to on to bypass Supabase
# with a fake member session. It is ignored in production even if configured.
AUTH_DEMO_MODE=

# Client-IP headers are trusted only from the selected reverse proxy. Vercel is
# detected automatically. For other deployments, choose cloudflare or generic
# only when that proxy overwrites incoming forwarding headers. The secure
# default is none, which puts requests into a shared rate-limit bucket.
TRUSTED_PROXY_PROVIDER=none

# Secret for the daily maintenance job in vercel.json (/api/cron/maintenance).
# Vercel sends it automatically. Use a long random value, at least 16
# characters, e.g. `openssl rand -hex 32`. The job refuses every request while
# this is empty. It also keeps a free-plan Supabase project from pausing.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Supabase  (database + customer/staff logins — server-only)
# -----------------------------------------------------------------------------
# Where to find each value in the Supabase dashboard (open your project):
#
#   SUPABASE_URL              Project Settings > Data API  (or the project home
#                             page), e.g. https://abcd1234.supabase.co
#   SUPABASE_PUBLISHABLE_KEY  Project Settings > API Keys  (starts sb_publishable_)
#                             Older projects: the "anon" key on the Legacy API
#                             Keys tab — either works here.
#   SUPABASE_SECRET_KEY       Project Settings > API Keys  (starts sb_secret_;
#                             click Reveal, or create one)
#                             Older projects: the "service_role" key on the
#                             Legacy API Keys tab — either works here.
#
# All three are read ONLY on the server. Never add NEXT_PUBLIC_ to these names.
# The secret key can read and change everything in the database: never share
# it, never commit it, and never paste it into a chat or a browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy name for the secret key, only read when SUPABASE_SECRET_KEY is empty:
# SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL connection string (Supabase dashboard > Connect > Shared Pooler).
# Used by the server-only Drizzle client and database tools. If the password
# contains reserved URL characters such as @, percent-encode them (for example,
# @ becomes %40). It contains the database password — keep it secret.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Payments — Stripe  (reserved: checkout adapter fails closed until set)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Transactional email  (reserved: contact / newsletter delivery adapter)
# -----------------------------------------------------------------------------
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
MERCH_SUPPORT_EMAIL=
BUSINESS_EMAIL=

# -----------------------------------------------------------------------------
# Social links  (optional — owner-approved public URLs only)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# -----------------------------------------------------------------------------
# Analytics  (optional — privacy-respecting, consent-gated)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=
