# Supabase PostgreSQL
# Project URL and a server-only secret key from Project Settings > API.
# SUPABASE_SECRET_KEY is preferred for new projects. The legacy service-role
# key is supported as a fallback. Never prefix either secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct/pooled PostgreSQL connection used for migrations and transactions.
DATABASE_URL=

# Admin/session
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
MERCH_SUPPORT_EMAIL=
